# Copy to `.env` and fill in. Only KAGGLE_APIKEYS is required to launch;
# everything else has a working default (shown in comments).
# UI-managed values (accounts, Telegram) override these once saved.

# Kaggle access tokens, comma-separated. Auto-registered as accounts on startup.
# A raw access token, a kaggle.json blob, or a mix all work.
KAGGLE_APIKEYS=your_kaggle_access_token_1,your_kaggle_access_token_2

# Dashboard login secret. Leave EMPTY to disable auth (local dev only).
APP_AUTH_TOKEN=a-long-random-string

# Telegram alerts: the bot DMs this numeric user ID on start / 11h warning /
# 12h cutoff / completion. Get your ID from @userinfobot, then press START
# on your bot once (bots can't message users who never started them).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=123456789

# READ-scoped token, injected into every pushed kernel's environment for
# faster downloads of public models/datasets. Takes effect on next launch.
HF_TOKEN=

# W&B logging for training kernels (kaggle_train_qwen3vl.py). Key is injected
# like HF_TOKEN; absent = training runs with reporting off, never crashes.
WANDB_API_KEY=
WANDB_PROJECT=fitcheck

# --- Paths & server ---
# Redirect all local state (db, notebooks, logs, outputs) elsewhere.
# Tests use this for isolation. Default: ./data
#AUTOMATION_DATA_DIR=
# Override the kaggle CLI discovery. Default: .venv/Scripts/kaggle, then PATH.
#KAGGLE_CLI_PATH=kaggle
# Bind address/port. Keep 127.0.0.1 unless you understand the exposure -
# and set APP_AUTH_TOKEN first.
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Concurrency caps (each `kaggle` CLI call is ~50-150MB; these caps are
# what keep parallel launches from OOM-killing the server) ---
#PUSH_CONCURRENCY=3
#STOP_CONCURRENCY=3
#KERNEL_STATUS_CONCURRENCY=3
#QUOTA_REFRESH_CONCURRENCY=3
#DISTRIBUTED_PUSH_CONCURRENCY=3
#DISTRIBUTED_STATUS_CONCURRENCY=3
#MONITOR_CONCURRENCY=3
#MAX_CONCURRENT_LOG_STREAMS=6

# --- Timeouts (seconds) ---
#KERNEL_STATUS_TIMEOUT_SECONDS=90
#QUOTA_CALL_TIMEOUT_SECONDS=90
#VERSIONED_FETCH_TIMEOUT_SECONDS=600
#VERSIONED_HTTP_TIMEOUT_SECONDS=60

# --- Behavior ---
# Quota-aware MAX_RUNTIME_MINUTES injection for GPU launches (self-finishing
# kernels beat quota death). Set 0 to disable entirely. Default: 1
#AUTO_QUOTA_RUNTIME_CAP=1
# Seconds between same-account pushes in a distributed batch. Default: 20
#INTER_PUSH_STAGGER_SECONDS=20
# Kaggle HTTP API base used by the versioned-output helper. Default below.
#KAGGLE_API_BASE=https://api.kaggle.com
